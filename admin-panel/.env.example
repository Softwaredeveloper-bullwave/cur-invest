# Local Mac browser (Vite dev server proxies /api → Django on :8000):
VITE_API_BASE_URL=/api/v1/admin-panel

# Direct Django URL (no Vite proxy):
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/admin-panel

# Production API from your Mac (requires staff login — set VITE_ADMIN_DEV_NO_AUTH=false):
# VITE_API_BASE_URL=https://api.capitalbullwave.com/api/v1/admin-panel
# VITE_ADMIN_DEV_NO_AUTH=false

# Phone/another computer on the same Wi-Fi:
# VITE_API_BASE_URL=http://192.168.1.26:8000/api/v1/admin-panel
