# Copy to EC2: /etc/systemd/system/bullwave.service
# Then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable bullwave
#   sudo systemctl restart bullwave
#   sudo systemctl status bullwave
#   curl -s http://127.0.0.1:8000/health/
#
# Adjust paths if your clone lives elsewhere (e.g. /var/www/bullwave).

[Unit]
Description=BullWave Django API (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/cur-invest/investingapp/backend
Environment="PATH=/home/ubuntu/cur-invest/investingapp/backend/venv/bin"
# gunicorn needs a writable temp dir — EC2 /tmp is sometimes missing or full
Environment="TMPDIR=/home/ubuntu/cur-invest/investingapp/backend/run/tmp"
ExecStartPre=/bin/mkdir -p /home/ubuntu/cur-invest/investingapp/backend/run/tmp
ExecStart=/home/ubuntu/cur-invest/investingapp/backend/venv/bin/gunicorn \
  --workers 3 \
  --bind 127.0.0.1:8000 \
  --timeout 120 \
  --worker-tmp-dir /home/ubuntu/cur-invest/investingapp/backend/run/tmp \
  --access-logfile - \
  --error-logfile - \
  backend.wsgi:application
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
