SECRET_KEY=change-me-in-production-use-long-random-string

# MUST be False on production server before Play Store launch
DEBUG=True
# React admin panel: skip JWT login while DEBUG=True (set False before go-live).
ADMIN_PANEL_DEV_NO_AUTH=True

ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,api.bullwave.in



# ── Database (PostgreSQL) ──

DB_NAME=bullwave_db

DB_USER=postgres

DB_PASSWORD=postgres

DB_HOST=localhost

DB_PORT=5432



# ── Market data — Kotak Neo Trade API (real-time NSE/BSE) ──
# Kotak Neo app → More → TradeAPI → API Dashboard → Access Token
KOTAK_NEO_ACCESS_TOKEN=your-kotak-neo-access-token
KOTAK_NEO_BASE_URL=https://mis.kotaksecurities.com
KOTAK_NEO_QUOTE_CACHE_SECONDS=15
KOTAK_NEO_UNIVERSE_CACHE_SECONDS=15
KOTAK_NEO_BATCH_SIZE=50
MARKET_DATA_PROVIDER=kotak_neo

# Optional fallbacks
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

MARKET_QUOTE_CACHE_SECONDS=30

MARKET_UNIVERSE_CACHE_SECONDS=60

NEWS_CACHE_MINUTES=15



# ── SMS OTP — twilio (live) | msg91 | console (dev only) ──
# All keys go in investingapp/backend/.env — restart Django after changes.
SMS_PROVIDER=twilio
# MUST be True for real SMS OTP (False = dev OTP in terminal / Flutter UI only).
SMS_OTP_ENABLED=True

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Verify (recommended): Service SID from Verify → Services (starts with VA)
TWILIO_SERVICE_SID=
# OR Twilio Messages: sender number in E.164 format (e.g. +14155552671)
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_CHANNEL=sms
# verify = Twilio Verify API | messages = send OTP via TWILIO_FROM_NUMBER (needs a Twilio number)
TWILIO_OTP_MODE=verify
# India (+91): enable Geo permissions in Twilio Console → Messaging → Settings → Geo permissions

# ── Payments — Razorpay (https://dashboard.razorpay.com) ──

RAZORPAY_KEY_ID=

RAZORPAY_KEY_SECRET=

RAZORPAY_WEBHOOK_SECRET=



# Cashfree PG + Payouts (same App ID / Secret from merchant dashboard → Developers)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=production
CASHFREE_PAYMENTS_BASE_URL=
CASHFREE_PAYOUTS_BASE_URL=
# Register webhook URL: {BACKEND_PUBLIC_URL}/api/v1/payment-webhook/
CASHFREE_PAYMENT_WEBHOOK_SECRET=
CASHFREE_PAYOUT_WEBHOOK_SECRET=
CASHFREE_PAYMENT_API_VERSION=2023-08-01



# ── KYC verification provider ──
# Legacy default when per-step KYC_*_PROVIDER vars are blank: cashfree | eko
KYC_PROVIDER=cashfree
# Per-step overrides (cashfree | eko). Blank = use KYC_PROVIDER for that step.
KYC_PAN_PROVIDER=eko
KYC_BANK_PROVIDER=eko
# provider = live API call; manual = admin reviews bank + UPI together (24h SLA).
KYC_BANK_REVIEW_MODE=provider
KYC_UPI_PROVIDER=
KYC_UPI_REQUIRED=False
KYC_AADHAAR_PROVIDER=eko
# Explicit test-only fallback for Cashfree when API is blocked. Keep False — wrong
# bank/UPI details would be marked verified without it.
CASHFREE_DEV_BYPASS=False

# ── Eko Platform Services (https://developers.eko.in) — KYC: PAN + bank verification ──
# PASTE YOUR EKO KEYS BELOW (from the credentials email Eko sends after org KYC
# at https://connect.eko.in, or the UAT block on https://developers.eko.in).
EKO_DEVELOPER_KEY=
# "Authenticator Key" in Eko's credentials email — used to sign each request.
EKO_ACCESS_KEY=
EKO_INITIATOR_ID=
# Usually same as EKO_INITIATOR_ID for single-retailer setups — leave blank to default to it.
EKO_USER_CODE=
# uat (sandbox, default) | production (after Eko approves your org KYC)
EKO_ENVIRONMENT=uat
# Explicit test-only fallback. Keep False for all real verification.
EKO_ALLOW_SANDBOX_BYPASS=False
# When Eko UPI Verification product is not enabled on the merchant account (status 97),
# optionally skip live UPI lookup. Keep False — any UPI ID would be accepted without it.
EKO_UPI_SOFT_VERIFY=False
# When Eko bank APIs fail, optionally skip live verification. Keep False — wrong account
# numbers would be marked verified without it.
EKO_BANK_SOFT_VERIFY=False
# Set True only while testing Eko bank API with accounts that are not in the user's PAN name.
KYC_BANK_SKIP_IDENTITY_MATCH=False
KYC_UPI_REQUIRED=False
# Prefer Penny-less bank verification; auto-fallback to penny-drop when unavailable.
EKO_PENNYLESS_ENABLED=True
# Partner slug from Eko Connect (docs example: touras). Required for Penny-less unless
# EKO_PENNYLESS_PATH is set explicitly.
EKO_ORG_SLUG=
# Optional full override, e.g. /v3/tools/kyc/your-slug/bank-acc-verify-penniless
EKO_PENNYLESS_PATH=
# Eko API logs — terminal always; optional file:
# Optional: EKO_LOG_LEVEL=DEBUG for more Eko HTTP detail in console + log file.
# In DEBUG mode, logs/eko_kyc.log is created automatically when this is unset.
# EKO_API_LOG_FILE=logs/eko_kyc.log
# UAT default: https://staging.eko.in/ekoapi (set automatically).
# PRODUCTION: REQUIRED — use the current Eko Connect organization base URL
# without a legacy gateway port, e.g. https://api.eko.in/ekoicici.
# The provider appends each endpoint version/path.
EKO_BASE_URL=
# Optional: separate host/port for UPI validate-vpa if Eko routes payments elsewhere.
# Example: https://api.eko.in:25002/ekoicici
EKO_UPI_BASE_URL=
# Optional public HTTPS page opened after DigiLocker consent. For local app
# testing use your public website; production can omit this to use the secure
# Optional override — leave blank to use BACKEND_PUBLIC_URL/api/v1/digilocker/callback/{state}/
# Do NOT set this to https://bullwave.in (marketing homepage). Use your API callback URL.
EKO_DIGILOCKER_REDIRECT_URL=
# Required in production. Encrypts the Aadhaar number only while an OTP flow is pending.
# Generate once and keep it stable:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENCRYPTION_KEY=
# One-time setup after pasting production keys:
#   python manage.py activate_eko_kyc_services
# (activates PAN + UPI service codes; also run activate_eko_pan_service if needed)
# Bank Verification + DigiLocker must be enabled on connect.eko.in by Eko support.
# Set EKO_ORG_SLUG (partner slug from Eko, e.g. touras) for penny-less bank verify.
# Aadhaar verification uses Eko DigiLocker (not Eko Aadhaar OTP). Eko must
# enable DigiLocker for this production account, and BACKEND_PUBLIC_URL below
# must be a public HTTPS URL accepted as the DigiLocker redirect URL.

# ── Compliance ──

# Sandbox/dev: auto-approve KYC when Cashfree IP is not whitelisted (never applies in production).
KYC_AUTO_APPROVE=True
# Dev/testing — relax KYC endpoint rate limits (defaults to DEBUG). Keep False in production.
KYC_RELAX_RATE_LIMITS=True

REFERRAL_REWARD_AMOUNT=500
APP_SHARE_URL=https://bullwave.in
# Flutter web URL — after DigiLocker, the API callback redirects here.
# Local Flutter web: http://localhost:58076 (port changes each run — update as needed)
APP_WEB_URL=http://localhost:58076

OTP_EXPIRY_MINUTES=5

# ── Manual KYC admin email (production) ──
# Pick ONE primary provider via EMAIL_PROVIDER, others auto-fallback if configured.
#
# | Provider  | EMAIL_PROVIDER | API key / password              | From address        |
# |-----------|----------------|----------------------------------|---------------------|
# | Brevo     | brevo          | BREVO_API_KEY                    | BREVO_FROM_EMAIL    |
# | SendGrid  | sendgrid       | SENDGRID_API_KEY                 | SENDGRID_FROM_EMAIL |
# | Gmail SMTP| smtp           | EMAIL_HOST_PASSWORD (app pwd)    | EMAIL_HOST_USER     |
#
# Free tiers: Brevo ~300/day | SendGrid ~100/day | Gmail ~500/day (app password)
# Brevo: https://app.brevo.com/settings/keys/api
# SendGrid: https://app.sendgrid.com/settings/api_keys
# Gmail app password: Google Account → Security → 2-Step → App passwords
EMAIL_PROVIDER=brevo  # smtp | sendgrid | brevo
ADMIN_KYC_EMAIL=bullwaveteam5@gmail.com
# F&O eligibility review (Form 16 / ITR / bank statement) — leave empty to use ADMIN_KYC_EMAIL
ADMIN_FNO_EMAIL=
# Optional phone for auto-created KYC email reviewer (Django staff user)
KYC_EMAIL_REVIEWER_PHONE=
# Public API URL — REQUIRED for DigiLocker redirects and email review links.
# Must be HTTPS. For local Django + Flutter web testing:
#   1. Run: ngrok http 8000
#   2. Set BACKEND_PUBLIC_URL=https://YOUR-ID.ngrok-free.app
# Production: https://api.bullwave.in
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Local DigiLocker HTTPS callback — run in a separate terminal:
#   npx localtunnel --port 8000
# Paste the https://….loca.lt URL here (required when BACKEND_PUBLIC_URL is http):
LOCAL_DEV_TUNNEL_URL=

# Brevo — verify sender under Senders & Domains; disable IP lock or whitelist server IP
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=BullWave Capital

# SendGrid — verify sender in SendGrid dashboard
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Gmail SMTP (automatic fallback when API providers fail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# F&O eligibility — minimum portfolio value for instant verification (INR)
FNO_MIN_PORTFOLIO_VALUE=50000



# ── AI — Ollama (local) or cloud ──

AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434

OLLAMA_MODEL=llama3.2:1b

OLLAMA_KEEP_ALIVE=30m

OLLAMA_NUM_CTX=2048

AI_TEMPERATURE=0.4

AI_MAX_TOKENS=350

AI_REQUEST_TIMEOUT=90

OPENAI_API_KEY=

# Optional — only if you use multiple OpenAI orgs/projects
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

OPENAI_MODEL=gpt-4o-mini

# OpenAI voice — TTS (nova/alloy/echo…) + Whisper STT (same API key)
AI_VOICE_PROVIDER=auto
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
OPENAI_STT_MODEL=whisper-1
OPENAI_STT_ENABLED=True

# Legacy ElevenLabs fallback (optional)

GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=

GROQ_MODEL=llama-3.1-8b-instant

# ── ElevenLabs AI voice (text-to-speech) ──
# Get API key: https://elevenlabs.io/app/settings/api-keys
# Pick a voice: https://elevenlabs.io/app/voice-design (create free) OR leave empty = auto-pick
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Broker APIs (future — live trading like Dhan/Zerodha) ──

KITE_API_KEY=

KITE_API_SECRET=

DHAN_CLIENT_ID=

DHAN_ACCESS_TOKEN=

# ── Play Store / production checklist ──
# Before publishing the Android app:
#   DEBUG=False
#   SECRET_KEY=<long random string>
#   ALLOWED_HOSTS=api.bullwave.in,your-server-ip
#   BACKEND_PUBLIC_URL=https://api.bullwave.in
#   SMS_PROVIDER=msg91 (or twilio) + valid API keys — OTP must send via SMS
#   KYC_AUTO_APPROVE=False
#   CORS: mobile apps do not need CORS; set CORS_ALLOWED_ORIGINS only for web
# Deploy Django behind HTTPS (nginx + Let's Encrypt), then build Flutter with:
#   API_BASE_URL=https://api.bullwave.in/api/v1
